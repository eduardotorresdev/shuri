{
  "name": "@shuri/migrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "shuri-migrate": "./bin/shuri-migrate.js"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@shuri/core": "workspace:*",
    "@shuri/validate": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shuri/config": "workspace:*",
    "@types/node": "^22.13.1",
    "vitest": "^3.2.4"
  }
}
